NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
PRIVATE_SUPABASE_SECRET=

# API keys
CFGI_API_KEY=
PRIVATE_COINGLASS_KEY=
PRIVATE_CRYPTOPANIC_KEY=
    
# RapidAPI YouTube API key (https://rapidapi.com/ytjar/api/yt-api)
RAPID_API_KEY=68e9434406mshfa1bb820e3dc136p117eb8jsn154b64b450e7

PUBLIC_NEWSLAB_URL=https://newslab.fomoed.io
NEXT_PUBLIC_USE_NEW_LOGIN=true

NEXT_PUBLIC_REOWN_PROJECT_ID=

# Redis is required for coinstats widget (only)
# This is the default URL
REDIS_URL=redis://localhost:6379

# Password may be configured if your redis instance requires it
REDIS_PASSWORD=foobared

# Smart signals backend
NEXT_PUBLIC_BACKEND_SMART_SIGNALS_BASE=http://localhost:8083
# Kuma monitors
KUMA_MONITOR_PUSH_URL_CRONJOB_NEWS="https://kuma.fomoed.io/api/push/lnQAY9i9ds?status=up&msg=OK&ping="

# Cignals
NEXT_PUBLIC_CIGNALS_WS_URL=wss://fomoed-livesocket.netbound.cz:3000
PRIVATE_CIGNALS_KEY=

# Stripe product IDs
STRIPE_PRODUCT_IDS_PRO_PLAN=
STRIPE_PRODUCT_IDS_PLUS_PLAN=

# Set's the domain of cookies. Allow's for the same login across multiple apps.
NEXT_PUBLIC_SUPABASE_COOKIE_DOMAIN=.fomoed.io

# Platform configuration
# Comma separated list of disabled widget slugs (completely hidden from widget modal), as defined in layoutOptionsMap
DISABLED_WG_SLUGS=trading-economics

# Comma separated list of widgets under maintenance (visible but not selectable in widget modal)
# If not set, uses hardcoded default list in static.tsx (currently: Coinglass API widgets)
# Set to empty string to clear all maintenance widgets: NEXT_PUBLIC_MAINTENANCE_WG_SLUGS=
# Set to custom list to override: NEXT_PUBLIC_MAINTENANCE_WG_SLUGS=widget-slug-1,widget-slug-2
# NEXT_PUBLIC_MAINTENANCE_WG_SLUGS=

# Logging

# By default, responses from (some) API routes are logged into the console
# to be able to check them inside vercel logs. If this is set to to a value,
# the response data will NOT be logged.
DISABLE_RESPONSE_LOG=true

# Sentry
NEXT_PUBLIC_SENTRY_ENV=development

NEXT_PUBLIC_FALLBACK_BINANCE_PROXY_URL=wss://binance-proxy.fomoed.io