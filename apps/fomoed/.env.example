USE_VERCEL=false
PRIVATE_STRIPE_WEBHOOK_SECRET=
PRIVATE_STRIPE_SECRET_KEY=
PRIVATE_STRIPE_PUBLIC_KEY=
PRIVATE_CRYPTOPANIC_KEY=

PRIVATE_STRIPE_PRICES=price_1PATdqDMkwFiXCq8mYl8JJmK, price_1PATdqKMkwFeXCq8mYl8JJmP # Should be comma separated prices from stripe

PRIVATE_SUPABASE_SECRET=
PUBLIC_SUPABASE_ANON=
PUBLIC_SUPABASE_URL=

PUBLIC_UI_ENABLE_XMAS=""

PUBLIC_NEWSLAB_URL=https://newslab.fomoed.io
PUBLIC_DASHBOARD_URL=http://localhost:3001

# Redis is required for coinstats widget (only)
# This is the default URL
PRIVATE_REDIS_URL=redis://localhost:6379

# Password may be configured if your redis instance requires it
PRIVATE_REDIS_PASSWORD=foobared

# Price IDs that are available to the users.
# Not all price IDs are available to users, because pricing can change. There will always be some archived/unused
# prices, that some existing subscriptions use. Therefore we need to specifi, which prices the users
# can use.
PUBLIC_AVAILABLE_PRICE_IDS=price_1PGN21Atd8wKdBoUfHeftZBw,price_1PEEilAtd8wKdBoU3sq6LTWa,price_1Q2WMsAtd8wKdBoU6n0JgPzf,price_1Q2WOBAtd8wKdBoUTDkWCQrf